# Systemd user unit voor de DSMR Reader -> HomeWizard bridge.
#
# Werkende methode op de Raspberry Pi (podman 4.3.1):
#   - Quadlet wordt NIET ondersteund (podman < 4.4)
#   - podman-compose hangt bij het starten van deze container
#   -> Unit genereren uit een draaiende container:
#
#   1. Image bouwen:
#        cd ~/dsmr-bridge
#        podman build -t localhost/dsmr-homewizard-bridge .
#
#   2. bridge.env aanmaken (kopie van bridge.env.example, vul API-key in):
#        cp ~/dsmr-bridge/bridge.env.example ~/dsmr-bridge/bridge.env
#        nano ~/dsmr-bridge/bridge.env
#
#   3. Container eenmalig starten. De bind-mount laat de container bridge.py
#      rechtstreeks uit ~/dsmr-bridge lezen, zodat een codewijziging alleen
#      kopieren + herstarten is in plaats van een volledige image-rebuild
#      (de vfs-storage-driver op een Pi 3B maakt dat erg traag):
#        podman run -d --name dsmr-homewizard-bridge \
#          --restart always -p 8080:80 \
#          --env-file ~/dsmr-bridge/bridge.env \
#          -v ~/dsmr-bridge/bridge.py:/app/bridge.py:ro \
#          localhost/dsmr-homewizard-bridge
#
#      De mount dekt ALLEEN bridge.py. Wijzig je de Containerfile, dan is er
#      nog wel een echte 'podman build' nodig.
#
#   4. Unit genereren en installeren:
#        podman generate systemd --new --name dsmr-homewizard-bridge \
#          > ~/.config/systemd/user/dsmr-homewizard-bridge.service
#        export XDG_RUNTIME_DIR=/run/user/$(id -u)
#        systemctl --user daemon-reload
#        systemctl --user enable --now dsmr-homewizard-bridge.service
#
#   (dsmrreader heeft linger aan -> service start ook na een reboot.)
#
# Let op: in de Solar Controller kun je als meteradres ook IP:poort invullen,
# bijv. 192.168.15.233:8080. Aanpassen van poort 80 of sysctl is dan NIET nodig.
#
# Onderstaande unit is de door podman gegenereerde, werkende versie.

[Unit]
Description=Podman container-dsmr-homewizard-bridge.service
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm \
        -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
        --cidfile=%t/%n.ctr-id \
        --cgroups=no-conmon \
        --rm \
        --sdnotify=conmon \
        --replace \
        -d \
        --name dsmr-homewizard-bridge \
        -p 8080:80 \
        --env-file /home/dsmrreader/dsmr-bridge/bridge.env \
        -v /home/dsmrreader/dsmr-bridge/bridge.py:/app/bridge.py:ro localhost/dsmr-homewizard-bridge
ExecStop=/usr/bin/podman stop \
        --ignore -t 10 \
        --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
        -f \
        --ignore -t 10 \
        --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
