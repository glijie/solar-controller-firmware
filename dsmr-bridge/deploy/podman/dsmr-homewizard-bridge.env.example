# Copy this file to ~/.config/containers/systemd/dsmr-homewizard-bridge.env
# on the Raspberry Pi and fill in YOUR DSMR Reader API key.
#
# Do NOT commit this file to git when it contains a real key.

# URL of the DSMR Reader container (host LAN IP + published port 7777).
DSMR_READER_URL=http://192.168.15.233:7777/api/v2/datalogger/dsmrreading?limit=1&ordering=-timestamp

# Your DSMR Reader API key (shown under Configuration -> API in DSMR Reader).
DSMR_READER_API_KEY=VOER_HIER_JE_API_KEY_IN

# Optional overrides:
# POLL_INTERVAL_S=5
# STALE_AFTER_S=30
# PHASE_VOLTAGE_V=230
