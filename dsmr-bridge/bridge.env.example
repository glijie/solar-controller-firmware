# Template voor de bridge-instellingen.
#
# Kopieer dit bestand naar  bridge.env  (in dezelfde map) en vul je eigen
# DSMR Reader API-key in:
#
#   cp bridge.env.example bridge.env
#   nano bridge.env
#
# bridge.env staat in .gitignore en wordt dus NOOIT gecommit.

# URL van DSMR Reader (host + gepubliceerde poort).
DSMR_READER_URL=http://192.168.15.233:7777/api/v2/datalogger/dsmrreading?limit=1&ordering=-timestamp

# Je DSMR Reader API-key (Configuration -> API in DSMR Reader).
DSMR_READER_API_KEY=VOER_HIER_JE_API_KEY_IN

# Optionele instellingen (standaardwaarden zijn prima):
# POLL_INTERVAL_S=5
# STALE_AFTER_S=30
# PHASE_VOLTAGE_V=230
# BRIDGE_UNIQUE_ID=dsmr-reader-bridge
